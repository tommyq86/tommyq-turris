# Copy to `hosts` (git-ignored) and edit; `deploy.sh system` installs it as /etc/hosts.
127.0.0.1 localhost

::1     localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters

# Local network (non-DHCP): address, short name, .lan name
192.168.1.2     desktop desktop.lan
192.168.1.3     desktop-win desktop-win.lan
192.168.1.4     nas nas.lan

# VPN
10.0.0.2        laptop laptop.lan

# DHCP static leases (fixed address per device)
192.168.1.5     phone phone.lan
192.168.1.6     smart-tv smart-tv.lan
