# sport.tommyq.cz - Sport subdomain (activities, route planner, garage)
# Token-based access control with HTTP Basic auth for admin actions
$HTTP["host"] == "sport.tommyq.cz" {

    # --- Redirect root / to /activity/ ---
    $HTTP["url"] == "/" {
        url.redirect = ( "^/$" => "https://sport.tommyq.cz/activity/" )
    }

    # --- Activity viewer: token access control (nevyžaduje se pro LAN) ---
    $HTTP["url"] =~ "^/activity" {
        $HTTP["remoteip"] != "192.168.2.0/24" {
            $HTTP["querystring"] !~ "token=(__ADMIN_TOKEN__|__PUBLIC_TOKEN__)" {
                url.redirect = ( ".*" => "https://tommyq.cz/" )
            }
        }
    }

    # --- Admin actions (refresh/delete/rename/auth) ---
    $HTTP["url"] =~ "^/activity/cgi/sport.cgi" {
        $HTTP["querystring"] =~ "(^|&)id=(refresh|delete|rename|auth)($|&)" {
            $HTTP["querystring"] !~ "token=__ADMIN_TOKEN__" {
                $HTTP["remoteip"] != "192.168.2.0/24" {
                    auth.backend = "pam"
                    auth.require = ( "" => (
                        "method" => "basic",
                        "realm" => "Sport Admin",
                        "require" => "valid-user"
                    ) )
                }
            }
        }
    }

    # --- Activity CGI script ---
    $HTTP["url"] =~ "^/activity/cgi/" {
        alias.url = ( "/activity/cgi" => "/srv/tommyq/sport/activity/cgi" )
        cgi.assign = ( ".cgi" => "" )
    }

    # --- BRouter routing API proxy ---
    $HTTP["url"] =~ "^/brouter/api/" {
        proxy.server = ( "" => ( ( "host" => var.nas_ip, "port" => 17777 ) ) )
        proxy.header = ( "map-urlpath" => ( "/brouter/api/" => "/" ) )
    }

    # --- BRouter CGI ---
    $HTTP["url"] =~ "^/brouter/cgi/" {
        alias.url = ( "/brouter/cgi" => "/srv/tommyq/sport/brouter/cgi" )
        cgi.assign = ( ".cgi" => "" )
    }

    # --- Static content ---
    $HTTP["url"] !~ "^/(activity/cgi|brouter/api|brouter/cgi)" {
        alias.url = ( "/activity" => "/srv/tommyq/sport/activity",
                      "/brouter"  => "/srv/tommyq/sport/brouter",
                      "/garage"   => "/srv/tommyq/sport/garage" )
        index-file.names = ( "index.html" )
    }

    # --- AUDIT: All sport.cgi calls ---
    $HTTP["url"] =~ "^/activity/cgi/sport.cgi" {
        setenv.add-environment = ( "SPORT_AUDIT" => "1" )
    }
}