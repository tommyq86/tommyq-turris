# Copy to `dnsmasq-local-domains.conf` (git-ignored) and edit; `deploy.sh system` installs it
# as /etc/dnsmasq.d/local-domains.conf.

# Local DNS overrides for *.example.com
# All subdomains resolve to the router (192.168.1.1), which reverse-proxies via lighttpd
address=/example.com/192.168.1.1

# Block AAAA to prevent IPv6 bypass to the CDN
address=/example.com/::

# Block HTTPS/SVCB records (prevents Chrome ECH errors)
filter-rr=HTTPS
