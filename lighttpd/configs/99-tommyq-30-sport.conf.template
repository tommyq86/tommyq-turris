# sport.tommyq.cz - Sport subdomain (activities, route planner, garage)
# Token-based access control with HTTP Basic auth for admin actions
$HTTP["host"] == "sport.tommyq.cz" {

    # --- Activity viewer: token access control ---
    $HTTP["url"] =~ "^/(index\.html|activity\.html)?$" {
        $HTTP["querystring"] !~ "token=(__ADMIN_TOKEN__|__PUBLIC_TOKEN__)" {
            url.redirect = ( "" => "https://tommyq.cz/" )
        }
    }

    # --- Admin CGI: HTTP Basic auth for auth endpoint (non-LAN without admin token) ---
    $HTTP["url"] =~ "^/cgi/sport\.cgi" {
        $HTTP["querystring"] =~ "id=auth" {
            $HTTP["querystring"] !~ "token=__ADMIN_TOKEN__" {
                $HTTP["remoteip"] != "192.168.2.0/24" {
                    auth.backend = "pam"
                    auth.require = ( "" => (
                        "method" => "basic",
                        "realm" => "Sport Admin",
                        "require" => "valid-user"
                    ) )
                }
            }
        }
    }

    # --- CGI scripts ---
    $HTTP["url"] =~ "^/cgi/" {
        alias.url = ( "/cgi" => "/srv/tommyq/sport/cgi" )
        cgi.assign = ( ".cgi" => "" )
    }

    # --- BRouter routing API proxy ---
    $HTTP["url"] =~ "^/brouter/api/" {
        proxy.server = ( "" => ( ( "host" => var.nas_ip, "port" => 17777 ) ) )
        proxy.header = ( "map-urlpath" => ( "/brouter/api/" => "/" ) )
    }

    # --- BRouter CGI ---
    $HTTP["url"] =~ "^/brouter/cgi/" {
        alias.url = ( "/brouter" => "/srv/tommyq/brouter" )
        cgi.assign = ( ".cgi" => "" )
    }

    # --- Static content ---
    $HTTP["url"] !~ "^/(cgi|brouter/api|brouter/cgi)" {
        alias.url = ( "/brouter" => "/srv/tommyq/brouter", "/garage" => "/www/tommyq/garage", "/" => "/srv/tommyq/sport/" )
        index-file.names = ( "index.html" )
    }
}
